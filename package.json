{
  "name": "weightlifting-calculator",
  "version": "1.0.0",
  "description": "Weightlifting calculator for Olympic lifts",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test",
    "test:e2e": "npx bddgen && npx playwright test",
    "test:headed": "npx bddgen && npx playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "playwright-bdd": "^7.0.0"
  }
}
